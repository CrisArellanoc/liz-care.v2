# Copia este archivo como .env.local y llena los valores del proyecto de Supabase
# (Project Settings → API). La llave publicable puede ir en el navegador; la secret/service_role nunca.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# true = la app usa Supabase (Auth, base de datos y Storage). false = datos de demostración en memoria.
VITE_SUPABASE_ACTIVO=false
